page {
  background:#F5F7FB;
  color:#0F172A;
  font-family:-apple-system,BlinkMacSystemFont,'PingFang SC','Microsoft YaHei',sans-serif;
  font-size:26rpx;
}
.container { padding:24rpx 24rpx 44rpx; box-sizing:border-box; max-width:900rpx; margin:0 auto; }
.card { background:#fff; border:1rpx solid #E8EDF5; border-radius:22rpx; padding:24rpx; box-shadow:0 6rpx 22rpx rgba(15,23,42,.045); margin-bottom:18rpx; box-sizing:border-box; }
.card.compact { padding:18rpx 20rpx; }
.h1 { font-size:40rpx; font-weight:800; line-height:1.2; letter-spacing:-1rpx; }
.h2 { font-size:29rpx; font-weight:750; line-height:1.35; }
.h3 { font-size:25rpx; font-weight:700; line-height:1.4; }
.muted { color:#64748B; line-height:1.5; }
.tiny { font-size:21rpx; color:#94A3B8; line-height:1.45; }
.row { display:flex; align-items:center; gap:12rpx; }
.between { display:flex; align-items:center; justify-content:space-between; gap:16rpx; }
.stack { display:flex; flex-direction:column; gap:10rpx; }
.badge { display:inline-flex; align-items:center; justify-content:center; padding:6rpx 13rpx; border-radius:999rpx; background:#EEF2F7; color:#475569; font-size:19rpx; line-height:1.4; white-space:nowrap; }
.badge.dark { background:#0F172A; color:#fff; }
.badge.warn { background:#FFF1F2; color:#BE123C; }
.badge.purple { background:#F3E8FF; color:#6D28D9; }
.btn { background:#0F172A; color:white; border-radius:15rpx; padding:15rpx 20rpx; font-size:24rpx; font-weight:700; text-align:center; box-sizing:border-box; }
.btn.secondary { background:#EEF2F7; color:#0F172A; }
.btn.ghost { background:#fff; border:1rpx solid #DCE3EC; color:#334155; }
.btn.danger { background:#FFF1F2; color:#BE123C; }
.btn.small { padding:11rpx 16rpx; font-size:21rpx; }
.section-title { font-size:21rpx; font-weight:800; letter-spacing:2rpx; color:#64748B; margin:26rpx 4rpx 13rpx; text-transform:uppercase; }
.empty { text-align:center; padding:42rpx 18rpx; color:#94A3B8; line-height:1.7; }
.event { border-left:7rpx solid #94A3B8; padding:16rpx 18rpx; background:#F8FAFC; border-radius:16rpx; margin-top:12rpx; box-sizing:border-box; }
.event-title { font-size:26rpx; font-weight:750; line-height:1.4; }
.event-meta { margin-top:6rpx; color:#64748B; font-size:22rpx; line-height:1.45; }
.exam { background:#FFF5F6; border-left-color:#E11D48; }
.personal-event { background:#FAF5FF; border-left-color:#7C3AED; }
.input { background:#F6F8FB; border:1rpx solid #E4E9F1; padding:17rpx 18rpx; border-radius:14rpx; margin:9rpx 0 15rpx; box-sizing:border-box; min-height:76rpx; font-size:25rpx; }
textarea.input { width:100%; min-height:150rpx; }
.form-label { font-size:21rpx; color:#64748B; font-weight:700; margin-top:6rpx; }
.pill-tabs { display:flex; background:#E9EEF5; border-radius:16rpx; padding:5rpx; gap:4rpx; }
.pill { flex:1; min-width:0; text-align:center; padding:12rpx 5rpx; border-radius:12rpx; font-size:22rpx; color:#64748B; }
.pill.active { background:#fff; color:#0F172A; font-weight:750; box-shadow:0 2rpx 10rpx rgba(15,23,42,.07); }
.progress { height:10rpx; background:#E7ECF3; border-radius:999rpx; overflow:hidden; }
.progress-fill { height:100%; background:#0F172A; border-radius:999rpx; }
.list-item { padding:20rpx 0; border-bottom:1rpx solid #E8EDF3; }
.list-item:last-child { border-bottom:none; }
.icon-btn { width:62rpx; height:62rpx; border-radius:16rpx; background:#fff; border:1rpx solid #DCE3EC; display:flex; align-items:center; justify-content:center; font-size:34rpx; color:#475569; }
.chip-row { display:flex; flex-wrap:wrap; gap:8rpx; }
.divider { height:1rpx; background:#E8EDF3; margin:18rpx 0; }
.floating-add { position:fixed; right:28rpx; bottom:150rpx; width:92rpx; height:92rpx; border-radius:50%; background:#0F172A; color:#fff; display:flex; align-items:center; justify-content:center; font-size:46rpx; box-shadow:0 12rpx 34rpx rgba(15,23,42,.24); z-index:20; }
.safe-bottom { height:120rpx; }

@media (max-width: 360px) {
  .container { padding-left:18rpx; padding-right:18rpx; }
  .card { padding:20rpx; border-radius:18rpx; }
  .h1 { font-size:36rpx; }
  .h2 { font-size:27rpx; }
  .pill { font-size:20rpx; padding-left:2rpx; padding-right:2rpx; }
}
