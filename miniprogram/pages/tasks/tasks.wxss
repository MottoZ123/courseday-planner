.page-head{display:flex;align-items:flex-end;justify-content:space-between;gap:18rpx}.filters{margin:24rpx 0 18rpx}.task{padding:22rpx}.task-main{min-width:0;flex:1}.task-title{word-break:break-word}.task-chips{margin-top:10rpx}.edit-link{color:#2563EB;font-size:23rpx;font-weight:700;padding:12rpx}.due-row{display:flex;align-items:baseline;gap:12rpx;margin:20rpx 0 12rpx}.due-date{font-size:30rpx;font-weight:800}.note{font-size:23rpx;color:#64748B;background:#F8FAFC;padding:13rpx 15rpx;border-radius:12rpx;margin-bottom:14rpx;line-height:1.5}.task-foot{margin-top:13rpx}.editor-mask{position:fixed;z-index:100;left:0;right:0;top:0;bottom:0;background:rgba(15,23,42,.42);display:flex;align-items:flex-end}.editor-sheet{width:100%;max-height:88vh;overflow-y:auto;background:#fff;border-radius:28rpx 28rpx 0 0;padding:28rpx 24rpx calc(30rpx + env(safe-area-inset-bottom));box-sizing:border-box}.editor-head{margin-bottom:12rpx}.close{width:58rpx;height:58rpx;border-radius:50%;background:#F1F5F9;color:#64748B;display:flex;align-items:center;justify-content:center;font-size:40rpx}.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:12rpx}.form-cell{min-width:0}.picker-value{white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.editor-actions{display:grid;grid-template-columns:1fr 1.4fr;gap:12rpx;margin-top:8rpx}
@media (max-width:360px){.form-grid{grid-template-columns:1fr}.editor-sheet{padding-left:18rpx;padding-right:18rpx}.task{padding:18rpx}.row{gap:7rpx}.btn.small{padding:10rpx 12rpx}}
