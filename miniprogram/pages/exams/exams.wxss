.page-head{display:flex;align-items:flex-end;justify-content:space-between;gap:18rpx}.exam-hint{margin-top:22rpx}.hint-text{margin-top:10rpx}.exam-card{border-left:10rpx solid #E11D48}.exam-card.custom-exam{border-left-color:#7C3AED}.exam-main{min-width:0;flex:1}.exam-date{font-size:27rpx;font-weight:800;color:#E11D48;white-space:nowrap}.exam-note{margin-top:10rpx;padding:12rpx 14rpx;background:#F8FAFC;border-radius:12rpx;color:#64748B;font-size:22rpx;line-height:1.5}.custom-actions{display:flex;gap:24rpx;margin-top:12rpx}.edit-link{color:#2563EB;font-size:22rpx;font-weight:700}.delete-link{color:#BE123C;font-size:22rpx;font-weight:700}.editor-mask{position:fixed;z-index:100;left:0;right:0;top:0;bottom:0;background:rgba(15,23,42,.42);display:flex;align-items:flex-end}.editor-sheet{width:100%;max-height:91vh;overflow-y:auto;background:#fff;border-radius:28rpx 28rpx 0 0;padding:28rpx 24rpx calc(30rpx + env(safe-area-inset-bottom));box-sizing:border-box}.editor-head{margin-bottom:12rpx}.close{width:58rpx;height:58rpx;border-radius:50%;background:#F1F5F9;color:#64748B;display:flex;align-items:center;justify-content:center;font-size:40rpx}.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:12rpx}.form-cell{min-width:0}.picker-value{white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.editor-actions{display:grid;grid-template-columns:1fr 1.4fr;gap:12rpx;margin-top:8rpx}@media(max-width:360px){.page-head{align-items:flex-start}.form-grid{grid-template-columns:1fr}.editor-sheet{padding-left:18rpx;padding-right:18rpx}.exam-date{font-size:23rpx}.exam-card>.between{align-items:flex-start;flex-direction:column}.exam-date{margin-top:4rpx}}
