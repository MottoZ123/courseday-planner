.page-head{display:flex;align-items:flex-end;justify-content:space-between;gap:18rpx}.info-card{margin-top:22rpx}.adjustment-card{border-left:9rpx solid #7C3AED}.adjustment-card.cancelled{border-left-color:#E11D48}.compare-row{display:grid;grid-template-columns:42rpx 1fr;gap:10rpx;align-items:start;margin-top:13rpx}.compare-label{width:38rpx;height:38rpx;border-radius:50%;background:#EEF2F7;color:#64748B;display:flex;align-items:center;justify-content:center;font-size:19rpx;font-weight:800}.compare-label.new{background:#F3E8FF;color:#6D28D9}.compare-text{font-size:22rpx;color:#475569;line-height:1.5}.note{margin-top:12rpx;padding:12rpx 14rpx;background:#F8FAFC;border-radius:12rpx;color:#64748B;font-size:22rpx;line-height:1.5}.actions{display:flex;gap:24rpx;margin-top:14rpx}.edit-link{color:#2563EB;font-size:22rpx;font-weight:700}.delete-link{color:#BE123C;font-size:22rpx;font-weight:700}.editor-mask{position:fixed;z-index:100;left:0;right:0;top:0;bottom:0;background:rgba(15,23,42,.42);display:flex;align-items:flex-end}.editor-sheet{width:100%;max-height:92vh;overflow-y:auto;background:#fff;border-radius:28rpx 28rpx 0 0;padding:28rpx 24rpx calc(30rpx + env(safe-area-inset-bottom));box-sizing:border-box}.editor-head{margin-bottom:12rpx}.close{width:58rpx;height:58rpx;border-radius:50%;background:#F1F5F9;color:#64748B;display:flex;align-items:center;justify-content:center;font-size:40rpx}.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:12rpx}.form-cell{min-width:0}.picker-value,.session-picker{white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.session-picker{font-size:22rpx}.original-card{background:#F8FAFC;border:1rpx solid #E8EDF5;border-radius:16rpx;padding:16rpx;margin-bottom:15rpx}.adjust-panel{background:#FAFAFF;border:1rpx solid #EDE9FE;border-radius:16rpx;padding:15rpx;margin-bottom:12rpx}.cancel-warning{background:#FFF1F2;border:1rpx solid #FECDD3;border-radius:16rpx;padding:17rpx;margin:8rpx 0 16rpx;color:#9F1239}.editor-actions{display:grid;grid-template-columns:1fr 1.4fr;gap:12rpx;margin-top:8rpx}@media(max-width:360px){.page-head{align-items:flex-start}.form-grid{grid-template-columns:1fr}.editor-sheet{padding-left:18rpx;padding-right:18rpx}}
