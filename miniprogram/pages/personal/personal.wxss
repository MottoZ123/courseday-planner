.page-head{display:flex;align-items:flex-end;justify-content:space-between;gap:18rpx}.summary{margin-top:22rpx}.personal-card{display:grid;grid-template-columns:88rpx 1fr;gap:18rpx;align-items:start}.date-badge{width:82rpx;height:82rpx;border-radius:19rpx;background:#F3E8FF;color:#6D28D9;display:flex;flex-direction:column;align-items:center;justify-content:center}.date-day{font-size:31rpx;font-weight:850;line-height:1}.event-body{min-width:0}.personal-title{word-break:break-word}.edit-link{color:#2563EB;font-size:23rpx;font-weight:700;padding:8rpx}.delete-link{color:#BE123C;font-size:22rpx;font-weight:700;margin-top:12rpx;display:inline-block}.note{margin-top:12rpx;padding:12rpx 14rpx;background:#FAF5FF;border-radius:12rpx;color:#64748B;font-size:22rpx;line-height:1.5}.chip-row{margin-top:9rpx}.event-date-text{margin-top:12rpx;font-size:23rpx;font-weight:700;color:#334155;line-height:1.45}.editor-mask{position:fixed;z-index:100;left:0;right:0;top:0;bottom:0;background:rgba(15,23,42,.42);display:flex;align-items:flex-end}.editor-sheet{width:100%;max-height:91vh;overflow-y:auto;background:#fff;border-radius:28rpx 28rpx 0 0;padding:28rpx 24rpx calc(30rpx + env(safe-area-inset-bottom));box-sizing:border-box}.editor-head{margin-bottom:12rpx}.close{width:58rpx;height:58rpx;border-radius:50%;background:#F1F5F9;color:#64748B;display:flex;align-items:center;justify-content:center;font-size:40rpx}.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:12rpx}.form-cell{min-width:0}.picker-value{white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.switch-row{display:flex;align-items:center;justify-content:space-between;gap:20rpx;padding:18rpx 2rpx;border-bottom:1rpx solid #EEF2F7;margin-bottom:14rpx}.editor-actions{display:grid;grid-template-columns:1fr 1.4fr;gap:12rpx;margin-top:8rpx}.schedule-panel{background:#F8FAFC;border:1rpx solid #E8EDF5;border-radius:18rpx;padding:18rpx;margin:4rpx 0 16rpx}.schedule-panel-title{font-size:25rpx;font-weight:800;margin-bottom:5rpx}.range-preview{background:#fff;border-radius:14rpx;padding:14rpx 16rpx;margin-top:4rpx}.duration-control{display:flex;align-items:center;background:#fff;border:1rpx solid #E4E9F1;border-radius:14rpx;min-height:76rpx;margin:9rpx 0 15rpx;overflow:hidden}.step-btn{width:68rpx;align-self:stretch;display:flex;align-items:center;justify-content:center;background:#EEF2F7;font-size:30rpx;font-weight:800}.duration-input{width:72rpx;text-align:center;font-size:27rpx;font-weight:800}.duration-unit{font-size:22rpx;color:#64748B;flex:1}.time-help{margin:-4rpx 2rpx 15rpx;padding:12rpx 14rpx;background:#F8FAFC;border-radius:12rpx}.mini-calendar{background:#fff;border:1rpx solid #E4E9F1;border-radius:16rpx;padding:12rpx;margin-top:14rpx}.mini-calendar-head{display:grid;grid-template-columns:54rpx 1fr 54rpx;align-items:center;text-align:center;padding:2rpx 2rpx 10rpx}.mini-nav{height:50rpx;border-radius:12rpx;background:#F1F5F9;display:flex;align-items:center;justify-content:center;font-size:32rpx;color:#475569}.mini-weeknames,.mini-grid{display:grid;grid-template-columns:repeat(7,1fr);gap:5rpx}.mini-weeknames view{text-align:center;color:#94A3B8;font-size:18rpx;padding:6rpx 0}.mini-day{height:58rpx;border-radius:12rpx;display:flex;align-items:center;justify-content:center;font-size:21rpx;color:#334155;background:#F8FAFC;border:1rpx solid transparent;box-sizing:border-box}.mini-day.blank{background:transparent}.mini-day.today{border-color:#CBD5E1}.mini-day.selected{background:#7C3AED;color:#fff;font-weight:800;border-color:#7C3AED}.selected-date-summary{margin-top:14rpx}.selected-date-chips{display:flex;flex-wrap:wrap;gap:8rpx;margin-top:10rpx;max-height:180rpx;overflow-y:auto}.date-chip{background:#F3E8FF;color:#6D28D9;border-radius:999rpx;padding:8rpx 12rpx;font-size:19rpx}.date-chip text{font-weight:800}.clear-dates{font-size:21rpx;color:#BE123C;font-weight:700;padding:8rpx}.empty-dates{padding:16rpx 4rpx}.no-margin{margin-top:0}
