.calendar-head{display:grid;grid-template-columns:62rpx 1fr 62rpx;align-items:center;gap:12rpx}.month-title-wrap{text-align:center}.legend{display:flex;align-items:center;justify-content:center;flex-wrap:wrap;gap:18rpx;margin:18rpx 0 14rpx;color:#64748B;font-size:20rpx}.legend view{display:flex;align-items:center;gap:7rpx}.calendar-card{background:#fff;border:1rpx solid #E8EDF5;border-radius:22rpx;padding:16rpx 12rpx 12rpx}.weeknames,.month-grid{display:grid;grid-template-columns:repeat(7,1fr);gap:5rpx}.weeknames{text-align:center;color:#94A3B8;font-size:19rpx;padding:3rpx 0 9rpx}.day-cell{height:86rpx;border-radius:13rpx;padding:8rpx;box-sizing:border-box;position:relative;background:#FAFBFD;border:1rpx solid transparent}.day-cell.selected{background:#0F172A;color:#fff}.day-cell.today:not(.selected){border-color:#94A3B8}.day-num{font-size:22rpx;font-weight:750}.dots{display:flex;gap:4rpx;margin-top:10rpx;flex-wrap:wrap}.dot{width:8rpx;height:8rpx;border-radius:50%;display:inline-block;flex:none}.lecture{background:#3B82F6}.examdot{background:#E11D48}.taskdot{background:#F59E0B}.personaldot{background:#7C3AED}.holiday-mark{position:absolute;right:7rpx;bottom:5rpx;font-size:15rpx;color:#94A3B8}.day-cell.selected .holiday-mark{color:#CBD5E1}.selected-head{display:flex;align-items:flex-end;justify-content:space-between;gap:15rpx;margin-top:24rpx}.selected-label{margin:0 0 5rpx}.day-detail{margin-top:12rpx}.holiday{padding:13rpx 15rpx;background:#F1F5F9;border-radius:13rpx;margin-bottom:12rpx;color:#475569}.task-row{display:grid;grid-template-columns:auto 1fr auto;gap:11rpx;align-items:center;padding:15rpx 0;border-bottom:1rpx solid #E8EDF0}.task-title{min-width:0;word-break:break-word}.personal-note{margin-top:6rpx}
@media (max-width:360px){.calendar-card{padding-left:8rpx;padding-right:8rpx}.weeknames,.month-grid{gap:3rpx}.day-cell{height:78rpx;padding:6rpx}.day-num{font-size:20rpx}.selected-head{align-items:center}.selected-head .btn{padding-left:12rpx;padding-right:12rpx}}
