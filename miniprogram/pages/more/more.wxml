    <view class="list-item" data-url="/pages/exams/exams" bindtap="go"><view class="between"><view><view class="h2">考试中心</view><view class="tiny">官方考试 + 自定义考试</view></view><text>›</text></view></view>
    <view class="list-item" data-url="/pages/personal/personal" bindtap="go"><view class="between"><view><view class="h2">个人事件</view><view class="tiny">旅行、面试、聚餐与私人安排</view></view><text>›</text></view></view>
    <view class="list-item" data-url="/pages/adjustments/adjustments" bindtap="go"><view class="between"><view><view class="h2">临时调课</view><view class="tiny">单节课程改期、改时、换教室或停课</view></view><text>›</text></view></view>
