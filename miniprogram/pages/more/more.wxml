    <view class="list-item" data-url="/pages/settings/settings" bindtap="go"><view class="between"><view><view class="h2">设置</view><view class="tiny">Tutorial分组与版本信息</view></view><text>›</text></view></view>
  </view>
  <view class="card version-card"><view class="tiny">TIMETABLE VERSION</view><view class="h2">{{meta.version}}</view><view class="muted">{{meta.source}}</view></view>
</view>
