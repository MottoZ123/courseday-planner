.today-head{display:flex;align-items:flex-end;justify-content:space-between;gap:18rpx}.load-chip{text-align:right}.load-num{font-size:31rpx;font-weight:850}.module-card{margin-top:20rpx;background:#F8FAFC}.module-progress{margin-top:14rpx}.module-foot{margin-top:8rpx}.next-card{margin-top:18rpx;background:#0F172A;color:#fff;border-color:#0F172A;padding:26rpx}.next-card .tiny,.next-card .section-label{color:#CBD5E1}.section-label{font-size:19rpx;font-weight:800;letter-spacing:3rpx}.next-date{font-size:20rpx;color:#94A3B8}.next-time{font-size:68rpx;font-weight:850;line-height:1;margin:20rpx 0 10rpx}.next-course{font-size:28rpx;font-weight:850}.next-name{font-size:25rpx;color:#CBD5E1;margin-top:4rpx}.next-meta{display:flex;align-items:center;justify-content:space-between;gap:12rpx;flex-wrap:wrap;margin-top:22rpx;color:#CBD5E1;font-size:22rpx}.countdown{background:rgba(255,255,255,.12);padding:9rpx 13rpx;border-radius:12rpx}.today-card{padding:10rpx 18rpx}.today-event{display:grid;grid-template-columns:78rpx 7rpx 1fr;gap:12rpx;align-items:stretch;padding:11rpx 0}.today-time{text-align:right;padding-top:6rpx}.time-main{font-size:23rpx;font-weight:850}.today-bar{border-radius:999rpx}.today-body{padding:4rpx 0 12rpx;min-width:0}.compact-empty{padding:30rpx 12rpx}.upcoming-grid{display:grid;grid-template-columns:1fr 1fr;gap:14rpx}.mini-card{margin-bottom:14rpx;min-width:0}.metric-big{font-size:36rpx;font-weight:850;margin:9rpx 0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.mini-desc{font-size:21rpx;color:#64748B;line-height:1.55;min-height:64rpx}.task-preview{margin-top:2rpx}.task-preview-title{font-weight:700;min-width:0;word-break:break-word}
@media (max-width:360px){.today-head{align-items:flex-start}.next-time{font-size:58rpx}.upcoming-grid{grid-template-columns:1fr}.mini-card{margin-bottom:0}.today-event{grid-template-columns:68rpx 6rpx 1fr}}
