.week-head{display:grid;grid-template-columns:62rpx 1fr 62rpx;gap:12rpx;align-items:center}.week-title{text-align:center}.mode-tabs{margin:22rpx 0 18rpx}.day-strip{width:100%;white-space:nowrap;margin:0 -2rpx}.day-strip-inner{display:flex;gap:10rpx;padding:2rpx 2rpx 12rpx;width:max-content}.day-chip{width:92rpx;min-height:116rpx;border-radius:18rpx;background:#fff;border:1rpx solid #E5EAF1;display:flex;flex-direction:column;align-items:center;justify-content:center;box-sizing:border-box}.day-chip.active{background:#0F172A;color:#fff;border-color:#0F172A}.day-chip.today:not(.active){border-color:#64748B}.day-week{font-size:19rpx;color:#94A3B8}.day-chip.active .day-week,.day-chip.active .day-count{color:#CBD5E1}.day-number{font-size:31rpx;font-weight:850;margin:3rpx 0}.day-count{font-size:17rpx;color:#94A3B8}.selected-day-head{display:flex;align-items:flex-end;justify-content:space-between;margin-top:12rpx}.selected-day-head .section-title{margin-bottom:4rpx}.timeline-card{padding:10rpx 18rpx}.timeline-item{display:grid;grid-template-columns:86rpx 26rpx 1fr;gap:8rpx;min-height:112rpx}.time-col{padding-top:18rpx;text-align:right}.time-start{font-weight:800;font-size:24rpx}.timeline-line{position:relative;display:flex;justify-content:center}.timeline-dot{position:absolute;top:25rpx;width:16rpx;height:16rpx;border-radius:50%;z-index:2}.line-tail{width:2rpx;background:#E2E8F0;height:100%}.timeline-item:last-child .line-tail{height:34rpx}.event-body{margin:10rpx 0 14rpx;background:#F8FAFC;border-radius:15rpx;padding:15rpx;min-width:0}.exam-body{background:#FFF5F6}.note{margin-top:6rpx}.module-summary{margin-bottom:14rpx}.pattern-day{padding:20rpx}.pattern-row{display:grid;grid-template-columns:82rpx 8rpx 1fr auto;gap:12rpx;align-items:center;padding:16rpx 0;border-bottom:1rpx solid #EDF1F5}.pattern-row:last-child{border-bottom:none}.pattern-time{font-weight:800;font-size:23rpx}.pattern-color{width:8rpx;height:58rpx;border-radius:999rpx}.pattern-main{min-width:0}.free-hint{margin-bottom:14rpx}.free-day{padding:20rpx}.free-block{padding:15rpx;background:#ECFDF5;color:#166534;border-radius:13rpx;margin-top:11rpx;text-align:center;font-weight:750}.no-free{margin-top:14rpx}
@media (max-width:360px){.day-chip{width:82rpx;min-height:106rpx}.timeline-item{grid-template-columns:74rpx 22rpx 1fr}.pattern-row{grid-template-columns:70rpx 7rpx 1fr auto}.event-body{padding:13rpx}}
