<view wx:if="{{course}}" class="container"><view class="code" style="color:{{course.color}}">{{course.code}}</view><view class="h1">{{course.nameZh}}</view><view class="muted">{{course.nameEn}}</view><view class="card summary"><view class="between"><view><view class="tiny">MODULE</view><view class="h2">{{course.module}}</view></view><view><view class="tiny">HOURS</view><view class="h2">{{hours}}h</view></view><view><view class="tiny">CREDITS</view><view class="h2">{{course.credits}}</view></view></view><view class="muted">{{course.instructor}}</view></view><view class="between"><view class="section-title">SCHEDULE</view><view class="btn small secondary" bindtap="openAdjustments">临时调课</view></view><view class="card"><view wx:for="{{events}}" wx:key="id" class="list-item"><view class="between"><view><view class="h2">{{item.date}} · {{item.timeText}}</view><view class="muted">{{item.type}} · {{item.venue || 'TBC'}}</view><view wx:if="{{item.rescheduled}}" class="tiny">原安排：{{item.originalDate}} · {{item.originalStartTime}}–{{item.originalEndTime}} · {{item.originalVenue || 'TBC'}}</view><view wx:if="{{item.note}}" class="tiny">{{item.note}}</view></view><view class="chip-row"><view wx:if="{{item.rescheduled}}" class="badge purple">已调课</view><view wx:if="{{item.source==='custom'}}" class="badge purple">个人考试</view><view class="badge">{{item.tutorialGroup || item.type}}</view></view></view></view></view><view class="section-title">TASKS</view><view class="card"><view wx:for="{{tasks}}" wx:key="id" class="list-item"><view class="between"><view>{{item.title}}</view><view class="badge">{{item.dueDate}}</view></view></view><view wx:if="{{!tasks.length}}" class="muted">暂无该课程任务，可在“任务”页添加。</view></view></view>
